class ModelSpace(App):
    TITLE = "model-space"
    CSS = CSS
    BINDINGS = [
        Binding("1", "show_tab('storage')", "Storage"),
        Binding("2", "show_tab('move')", "Move"),
        Binding("3", "show_tab('cleanup')", "Clean up"),
        Binding("r", "rescan", "Rescan"),
        Binding("q", "quit", "Quit"),
    ]

    def __init__(self, args):
        super().__init__()
        self.args = args
        self.models: list[Model] = []
        self.disks: list[Disk] = get_disks()
        self.config = load_json(CONFIG_FILE, {})
        self.scanning = False
        self.scanned_at = 0.0
        self.scan_note = ""
        self.cancel = threading.Event()
        self.protected = mount_points() | {HOME, "/"}

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with TabbedContent(id="tabs"):
            with TabPane("Storage", id="storage"):
                yield StorageView(id="storage-view")
            with TabPane("Move models", id="move"):
                yield MoveView(id="move-view")
            with TabPane("Clean up", id="cleanup"):
                yield CleanupView(id="cleanup-view")
        yield Static(id="status")
        yield Footer()

    def on_mount(self) -> None:
        theme = self.config.get("theme", "tokyo-night")
        if theme in self.available_themes:
            self.theme = theme
        self.watch(self, "theme", self._theme_changed, init=False)
        self.sub_title = os.uname().nodename
        cached = None if self.args.rescan else load_cache()
        if cached:
            self.models, self.scanned_at = cached
            mark_dups(self.models)
            mark_bulk(self.models)
        for v in self.lists():
            v.set_disks(self.disks)
        self.call_after_refresh(self.models_changed)
        self.set_interval(3, self.tick)
        self.set_interval(20, self.refresh_usage)
        self.action_rescan()
        if self.models:
            self.refresh_usage()

    def lists(self) -> list[ModelList]:
        return [self.query_one(MoveView), self.query_one(CleanupView)]

    def mount_of(self, m: Model) -> str:
        return next((d.mount for d in self.disks if d.dev == m.dev), "?")

    def _theme_changed(self, theme: str) -> None:
        self.config["theme"] = theme
        save_json(CONFIG_FILE, self.config)
        self.models_changed()

    # ── refresh plumbing
    def models_changed(self) -> None:
        self.query_one(StorageView).refresh_data(self.disks, self.models, self.scanning)
        for v in self.lists():
            v.rebuild()
        self.update_status()

    def tick(self) -> None:
        for d in self.disks:
            d.refresh()
        self.query_one(StorageView).refresh_data(self.disks, self.models, self.scanning)
        for v in self.lists():
            v.summary_changed()
        self.update_status()

    def update_status(self, live: str = "") -> None:
        p = palette(self)
        t = Text(no_wrap=True, overflow="ellipsis")
        if self.scanning:
            t.append("⟳ scanning ", style=f"bold {p.accent}")
            t.append(live or self.scan_note, style=p.muted)
        else:
            t.append("✔ ", style=p.ok)
            t.append(f"{len(self.models)} models indexed", style=p.fg)
            if self.scanned_at:
                t.append(f" · scanned {ago(self.scanned_at) if days_since(self.scanned_at) >= 1 else time.strftime('%H:%M', time.localtime(self.scanned_at))}", style=p.muted)
            if self.scan_note:
                t.append(f" · {self.scan_note}", style=p.muted)
            t.append(" · r rescans", style=p.muted)
        for w in self.query("#status"):
            w.update(t)

    # ── scanning
    def action_rescan(self) -> None:
        if self.scanning:
            return
        self.scanning = True
        self.scan_note = "starting…"
        self.update_status()
        self.scan_worker()

    @work(thread=True, exclusive=True, group="scan")
    def scan_worker(self) -> None:
        t0 = time.monotonic()

        def progress(n: int, path: str) -> None:
            try:
                self.call_from_thread(self.update_status, f"{n:,} folders · {short_path(path)}")
            except RuntimeError:
                pass
        disks = get_disks()
        sc = Scanner(disks, self.args.root, progress)
        try:
            models = sc.run(self.args.min_size)
            ann = annotate(models)
        except Exception as e:  # keep the TUI alive; show what broke
            self.call_from_thread(self.scan_failed, repr(e))
            return
        self.call_from_thread(self.scan_done, disks, models, ann, time.monotonic() - t0, sc.dirs_seen)

    def scan_failed(self, err: str) -> None:
        self.scanning = False
        self.scan_note = f"scan failed: {err}"
        self.update_status()

    def scan_done(self, disks, models, ann, secs: float, ndirs: int) -> None:
        self.scanning = False
        self.disks = disks
        self.models = models
        self.scanned_at = time.time()
        self.scan_note = f"{ndirs:,} folders in {secs:.0f}s"
        self.apply_annotations(ann, rebuild=False)
        mark_dups(models)
        mark_bulk(models)
        save_cache(models, self.scanned_at)
        for v in self.lists():
            v.set_disks(disks)
        self.models_changed()

    @work(thread=True, exclusive=True, group="usage")
    def refresh_usage(self) -> None:
        if self.scanning:
            return
        models = list(self.models)
        ann = annotate(models)
        self.call_from_thread(self.apply_annotations, ann)

    def apply_annotations(self, ann: dict, rebuild: bool = True) -> None:
        changed = False
        for m in self.models:
            if m.key in ann:
                users, services, writable = ann[m.key]
                if (users, services, writable) != (m.users, m.services, m.writable):
                    m.users, m.services, m.writable = users, services, writable
                    changed = True
        if changed and rebuild:
            for v in self.lists():
                v.rebuild()

    def action_show_tab(self, tab: str) -> None:
        self.query_one(TabbedContent).active = tab
        if tab != "storage":
            self.call_after_refresh(lambda: self.query_one(f"#{tab}-view", ModelList).table.focus())

    # ── move
    def confirm_move(self, models: list[Model], dest: str, leave_link: bool) -> None:
        items, skipped, error = plan_moves(models, dest, self.disks)
        p = palette(self)
        dest = os.path.abspath(os.path.expanduser(dest))
        body = Text()
        ddisk = disk_for_path(self.disks, dest)
        if not os.path.isdir(dest):
            body.append(f"Will create {dest}\n\n", style=p.accent)
        for it in items:
            m = it.model
            body.append("  ▸ ", style=p.accent)
            body.append(m.name, style=f"bold {p.fg}")
            body.append(f"  {human(m.size)}  ", style=p.fg)
            if it.same_fs:
                body.append("rename (instant)\n", style=p.ok)
            else:
                body.append(f"copy {human(it.nbytes)}\n", style=p.accent)
            body.append(f"      {short_path(m.path)}  →  {short_path(it.pairs[0][1])}"
                        + (f"  (+{len(it.pairs) - 1} more)" if len(it.pairs) > 1 else "") + "\n", style=p.muted)
            for u, s in m.services:
                body.append(f"      referenced by {u} ({s})"
                            + ("" if leave_link else " — will break without the symlink") + "\n",
                            style=p.warn if leave_link else p.err)
        for m, why in skipped:
            body.append("  ✗ ", style=p.err)
            body.append(f"{m.name}", style=p.fg)
            body.append(f" — skipped: {why}\n", style=p.muted)
        copy_bytes = sum(i.nbytes for i in items)
        if items:
            body.append("\n")
            if copy_bytes and ddisk and not error:
                body.append(f"{ddisk.mount}: {human(ddisk.free)} free → {human(ddisk.free - copy_bytes)} after\n", style=p.fg)
            body.append("A symlink will be left at each old location.\n" if leave_link
                        else "No symlinks will be left behind.\n", style=p.muted)
            if copy_bytes:
                body.append("Originals are removed only after every file is copied and verified.", style=p.muted)
        if error:
            body.append(f"\n\n{error}", style=f"bold {p.err}")
        ok = bool(items) and not error

        def go(yes: bool | None) -> None:
            if yes:
                if ddisk:
                    self.config.setdefault("dest", {})[ddisk.mount] = dest
                    save_json(CONFIG_FILE, self.config)
                self.start_move(items, leave_link, copy_bytes)
        self.push_screen(ConfirmScreen(f"Move {len(items)} model{'s' * (len(items) != 1)} to {short_path(dest)}",
                                       body, f"Move {len(items)}", "primary", can_confirm=ok), go)

    def start_move(self, items: list[MoveItem], leave_link: bool, total: int) -> None:
        self.cancel.clear()
        screen = OpScreen(f"Moving {len(items)} model{'s' * (len(items) != 1)}", total or 1, self.cancel)
        self.push_screen(screen)
        self.move_worker(items, leave_link, screen)

    @work(thread=True, exclusive=True, group="op")
    def move_worker(self, items: list[MoveItem], leave_link: bool, screen: OpScreen) -> None:
        ui = Reporter(self, screen)
        moved, failed = [], 0
        for i, it in enumerate(items, 1):
            m = it.model
            if self.cancel.is_set():
                break
            ui.call(screen.set_current, f"[{i}/{len(items)}] {m.name}")
            busy = users_of(m, open_weight_files())
            if busy:
                ui.call(screen.log_line, f"✗ {m.name}: now in use by {', '.join(busy)} — skipped", "err")
                failed += 1
                continue
            try:
                execute_move(it, leave_link, ui.progress, self.cancel)
            except Cancelled:
                ui.call(screen.log_line, f"✗ {m.name}: cancelled — originals untouched, partial copy removed", "warn")
                break
            except Exception as e:
                ui.call(screen.log_line, f"✗ {m.name}: {e} — originals untouched", "err")
                failed += 1
                continue
            ui.flush()
            moved.append(it)
            how = "renamed" if it.same_fs else "copied"
            ui.call(screen.log_line, f"✔ {m.name} {how} → {short_path(os.path.dirname(it.pairs[0][1]))}", "ok")
        ui.flush()
        summary = f"Moved {len(moved)} of {len(items)}" + (f" · {failed} failed" if failed else "")
        ui.call(screen.finish, summary)
        ui.call(self.after_move, moved, leave_link)

    def after_move(self, moved: list[MoveItem], leave_link: bool) -> None:
        for it in moved:
            m = it.model
            old_key = m.key
            m.path = map_moved(m.path, it.pairs)
            m.files = [map_moved(f, it.pairs) for f in m.files]
            m.key = m.path
            d = disk_for_path(self.disks, m.path)
            if d:
                m.dev = d.dev
            if leave_link:
                m.links = list(m.links) + [s for s, _ in it.pairs]
            for v in self.lists():
                v.selected.discard(old_key)
        self.after_op()

    # ── delete
    def confirm_delete(self, models: list[Model]) -> None:
        p = palette(self)
        ok_models = [m for m in models if not m.users and m.writable]
        skipped = [m for m in models if m not in ok_models]
        body = Text()
        frees = Counter()
        for m in ok_models:
            frees[m.dev] += m.frees
        body.append(f"Frees {human(sum(frees.values()))}\n", style=f"bold {p.ok}")
        for d in self.disks:
            if frees[d.dev]:
                body.append(f"  {d.mount:<14}", style=p.secondary)
                body.append(f"{human(d.free)} → {human(d.free + frees[d.dev])} free\n", style=p.fg)
        body.append("\n")
        for m in sorted(ok_models, key=lambda m: m.last_used):
            body.append(f"  {ago(m.last_used):>10}  ", style=age_style(p, m.last_used))
            body.append(m.name, style=f"bold {p.fg}")
            body.append(f"  {human(m.size)}\n", style=p.fg)
            what = (f"Ollama model ({'ollama rm' if not os.access(m.extra.get('store', ''), os.W_OK) else 'manifest + unshared blobs'})"
                    if m.source == "ollama" else
                    f"{short_path(m.path)}/  (whole folder)" if m.is_dir else
                    f"{short_path(m.location)}/  ({m.nfiles} files)" if m.nfiles > 1 else short_path(m.path))
            body.append(f"              {what}\n", style=p.muted)
            for u, s in m.services:
                body.append(f"              ⚠ referenced by {u} ({s}) — it will fail to start\n", style=p.warn)
            for dpath in m.dups[:1]:
                body.append(f"              another copy stays at {short_path(dpath)}\n", style=p.primary)
            if m.links:
                body.append(f"              {len(m.links)} symlink(s) to it will be removed\n", style=p.muted)
        for m in skipped:
            why = f"in use by {', '.join(m.users)}" if m.users else "no permission"
            body.append(f"  ✗ {m.name} — skipped: {why}\n", style=p.err)
        body.append("\nThis cannot be undone.", style=f"bold {p.err}")

        def go(yes: bool | None) -> None:
            if yes:
                self.start_delete(ok_models)
        self.push_screen(ConfirmScreen(f"Delete {len(ok_models)} model{'s' * (len(ok_models) != 1)}?",
                                       body, f"Delete {len(ok_models)}", "error", can_confirm=bool(ok_models)), go)

    def start_delete(self, models: list[Model]) -> None:
        self.cancel.clear()
        screen = OpScreen(f"Deleting {len(models)} model{'s' * (len(models) != 1)}",
                          sum(m.size for m in models), self.cancel)
        self.push_screen(screen)
        self.delete_worker(models, screen)

    @work(thread=True, exclusive=True, group="op")
    def delete_worker(self, models: list[Model], screen: OpScreen) -> None:
        ui = Reporter(self, screen)
        gone, failed = [], 0
        omap = open_weight_files()
        for i, m in enumerate(models, 1):
            if self.cancel.is_set():
                ui.call(screen.log_line, "Stopped — remaining models were left alone.", "warn")
                break
            ui.call(screen.set_current, f"[{i}/{len(models)}] {m.name}")
            busy = users_of(m, omap)
            if busy:
                ui.call(screen.log_line, f"✗ {m.name}: in use by {', '.join(busy)} — skipped", "err")
                failed += 1
                continue
            try:
                execute_delete(m, self.protected)
            except Exception as e:
                ui.call(screen.log_line, f"✗ {m.name}: {e}", "err")
                failed += 1
                continue
            gone.append(m)
            ui.progress(m.size)
            ui.flush()
            ui.call(screen.log_line, f"✔ deleted {m.name} ({human(m.frees)})", "ok")
        summary = f"Deleted {len(gone)} of {len(models)} · freed {human(sum(m.frees for m in gone))}" \
            + (f" · {failed} failed" if failed else "")
        ui.call(screen.finish, summary)
        ui.call(self.after_delete, gone)

    def after_delete(self, gone: list[Model]) -> None:
        keys = {m.key for m in gone}
        self.models = [m for m in self.models if m.key not in keys]
        for v in self.lists():
            v.selected -= keys
        self.after_op()

    def after_op(self) -> None:
        for d in self.disks:
            d.refresh()
        mark_dups(self.models)
        mark_bulk(self.models)
        save_cache(self.models, self.scanned_at)
        self.models_changed()
        self.refresh_usage()


class Reporter:
    """Batches progress from a worker thread into ~10 UI updates a second."""

    def __init__(self, app: App, screen: OpScreen):
        self.app, self.screen = app, screen
        self.pending = 0
        self.last = 0.0

    def call(self, fn, *args) -> None:
        try:
            self.app.call_from_thread(fn, *args)
        except RuntimeError:
            pass

    def progress(self, n: int) -> None:
        self.pending += n
        now = time.monotonic()
        if now - self.last >= 0.1:
            self.flush()
            self.last = now

    def flush(self) -> None:
        if self.pending:
            n, self.pending = self.pending, 0
            self.call(self.screen.advance, n)


def print_list(args) -> None:
    disks = get_disks()
    for d in disks:
        print(f"{d.mount:<14} {human(d.used):>10} used {human(d.free):>10} free  {d.frac * 100:4.0f}%  {d.label}")
    t0 = time.monotonic()
    sc = Scanner(disks, args.root)
    models = sc.run(args.min_size)
    ann = annotate(models)
    for m in models:
        m.users, m.services, m.writable = ann[m.key]
    mark_dups(models)
    mark_bulk(models)
    save_cache(models, time.time())
    mount = {d.dev: d.mount for d in disks}
    print(f"\n{len(models)} models, {human(model_bytes(models))}, "
          f"{sc.dirs_seen:,} folders in {time.monotonic() - t0:.1f}s\n")
    for m in sorted(models, key=lambda m: m.last_used):
        flags = " ".join(f for f, on_ in [("USE", m.users), ("SVC", ",".join(u for u, _ in m.services)), ("DUP", m.dups),
                                           ("LINK", m.links), ("RO", not m.writable)] if on_)
        print(f"{used_label(m):>10}  {human(m.size):>9}  {m.format_label:<14} "
              f"{mount.get(m.dev, '?'):<11} {m.name[:50]:<50} {short_path(m.path, 60):<60} {flags}")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--rescan", action="store_true", help="ignore the cached index on startup")
    ap.add_argument("--min-size", type=parse_size, default=parse_size("200M"),
                    help="hide models smaller than this (default 200M)")
    ap.add_argument("--root", action="append", default=[], help="extra folder to scan (repeatable)")
    ap.add_argument("--list", action="store_true", help="print the index (and refresh the cache) and exit")
    args = ap.parse_args()
    if args.list:
        print_list(args)
        return
    ModelSpace(args).run()


if __name__ == "__main__":
    main()
