@dataclass
class Model:
    key: str
    name: str
    kind: str                 # gguf, safetensors, bin, pytorch, onnx, partial, ...
    path: str                 # the folder for folder models, else the first file
    is_dir: bool
    files: list               # weight files (inside the folder, for folder models)
    nfiles: int
    size: int                 # bytes allocated on disk
    frees: int                # bytes deleting it would free (hard links, shared blobs excluded)
    last_used: float
    mtime: float
    dev: int
    signature: list           # [(basename, size)] of the main weights, for spotting copies
    source: str = ""          # "" | "hf" | "ollama"
    links: list = field(default_factory=list)   # symlinks elsewhere that point into it
    extra: dict = field(default_factory=dict)
    # runtime only, recomputed after every scan / load
    users: list = field(default_factory=list)      # ["llama-server[1234]"]
    services: list = field(default_factory=list)   # [("x.service", "active")]
    dups: list = field(default_factory=list)       # paths of copies
    writable: bool = True
    bulk: int = 0             # >0: atime shared with this many others (a backup/scan read them)

    RUNTIME = ("users", "services", "dups", "writable", "bulk")

    def to_json(self) -> dict:
        d = asdict(self)
        for k in self.RUNTIME:
            d.pop(k)
        return d

    @classmethod
    def from_json(cls, d: dict) -> "Model":
        names = {f.name for f in fields(cls)}
        return cls(**{k: v for k, v in d.items() if k in names})

    @property
    def location(self) -> str:
        """The folder for folder models (with a trailing /), else the containing folder."""
        if self.source == "ollama":
            return self.extra.get("store", os.path.dirname(self.path)) + "/"
        return self.path + "/" if self.is_dir else os.path.dirname(self.path)

    @property
    def format_label(self) -> str:
        if self.source == "ollama":
            return "Ollama"
        label = {"gguf": "GGUF", "safetensors": "safetensors", "pytorch": "PyTorch",
                 "onnx": "ONNX", "partial": "partial", "bin": "bin"}.get(self.kind, self.kind)
        if self.source == "hf":
            return f"HF {label}"
        return f"{label} ×{self.nfiles}" if self.nfiles > 1 else label


def looks_weight(name: str) -> bool:
    n = name.lower()
    stem, ext = os.path.splitext(n)
    if ext in KIND_BY_EXT:
        return True
    if ext in PARTIAL_EXT:
        return ext == ".incomplete" or os.path.splitext(stem)[1] in KIND_BY_EXT
    return False


def is_partial(name: str) -> bool:
    return os.path.splitext(name.lower())[1] in PARTIAL_EXT


@dataclass
class FileRec:
    path: str
    size: int     # allocated bytes
    apparent: int
    atime: float
    mtime: float
    dev: int
    ino: int
    nlink: int


class Scanner:
    """Parallel walk of every filesystem collecting weight files, symlinks, HF
    hub repos and Ollama stores."""

    def __init__(self, disks: list[Disk], extra_roots=(), progress=None, threads: int = 12):
        self.disks = disks
        self.extra_roots = [os.path.abspath(r) for r in extra_roots]
        self.progress = progress
        self.threads = threads
        self.mounts = mount_points()
        self.files: list[FileRec] = []
        self.links: list[str] = []
        self.hf_dirs: list[str] = []
        self.ollama_stores: list[str] = []
        self.dirs_seen = 0
        self._lock = threading.Lock()
        self._last_report = 0.0

    def roots(self) -> list[str]:
        out = []
        for d in self.disks:
            if d.mount in NO_SCAN_MOUNTS:
                continue
            if d.mount == "/":
                try:
                    top = sorted(os.listdir("/"))
                except OSError:
                    top = []
                for name in top:
                    p = "/" + name
                    if name not in ROOT_SKIP_TOP and p not in self.mounts \
                            and os.path.isdir(p) and not os.path.islink(p):
                        out.append(p)
                out += [p for p in ROOT_EXTRA if os.path.isdir(p)]
            else:
                out.append(d.mount)
        for r in self.extra_roots:
            if os.path.isdir(r) and not any(r == o or r.startswith(o.rstrip("/") + "/") for o in out):
                out.append(r)
        return out

    def _visit(self, d: str, q: queue.Queue) -> None:
        try:
            it = os.scandir(d)
        except OSError:
            return
        with it:
            for e in it:
                try:
                    if e.is_symlink():
                        self.links.append(e.path)
                    elif e.is_dir(follow_symlinks=False):
                        if e.name in SKIP_DIR_NAMES or e.path in self.mounts:
                            continue
                        if e.name.startswith("models--") and os.path.basename(d) == "hub":
                            self.hf_dirs.append(e.path)
                        elif e.name == "blobs" and os.path.isdir(os.path.join(d, "manifests")):
                            self.ollama_stores.append(d)
                        elif e.name == "manifests" and os.path.isdir(os.path.join(d, "blobs")):
                            pass
                        else:
                            q.put(e.path)
                    elif e.is_file(follow_symlinks=False) and looks_weight(e.name):
                        st = e.stat(follow_symlinks=False)
                        if st.st_size >= MIN_FILE:
                            self.files.append(FileRec(e.path, st.st_blocks * 512, st.st_size,
                                                      st.st_atime, st.st_mtime, st.st_dev,
                                                      st.st_ino, st.st_nlink))
                except OSError:
                    pass
        with self._lock:
            self.dirs_seen += 1
            now = time.monotonic()
            if self.progress and now - self._last_report > 0.1:
                self._last_report = now
                self.progress(self.dirs_seen, d)

    def walk(self) -> None:
        q: queue.Queue = queue.Queue()
        for r in self.roots():
            q.put(r)

        def worker():
            while True:
                d = q.get()
                if d is None:
                    q.task_done()
                    return
                try:
                    self._visit(d, q)
                except Exception:
                    pass  # one unreadable folder must not stall the whole walk
                finally:
                    q.task_done()

        ts = [threading.Thread(target=worker, daemon=True) for _ in range(self.threads)]
        for t in ts:
            t.start()
        q.join()
        for _ in ts:
            q.put(None)
        for t in ts:
            t.join()

    def run(self, min_size: int) -> list[Model]:
        self.walk()
        protected = set(self.mounts) | set(self.roots()) | {HOME, "/"}
        models = build_models(self.files, protected)
        models += [m for d in self.hf_dirs if (m := hf_model(d))]
        for s in self.ollama_stores:
            models += ollama_models(s)
        models = [m for m in models if m.size >= min_size]
        attach_links(models, self.links)
        return models


@dataclass
class Group:
    dir: str
    key: tuple
    files: list

    @property
    def partial(self) -> bool:
        return self.key[0] == "partial"

    @property
    def ext(self) -> str:
        return self.key[2] if self.key[0] == "shard" else os.path.splitext(self.key[1])[1].lower()

    @property
    def kind(self) -> str:
        return "partial" if self.partial else KIND_BY_EXT.get(self.ext, "weights")

    @property
    def stem(self) -> str:
        if self.partial:
            return f"partial download ({os.path.basename(self.dir)})"
        s = self.key[1] if self.key[0] == "shard" else os.path.splitext(self.key[1])[0]
        if s.lower() in GENERIC_STEMS or s.lower().startswith("mmproj"):
            return f"{os.path.basename(self.dir)}/{s}"
        return s

    @property
    def primary_gguf(self) -> bool:
        return (self.kind == "gguf"
                and not os.path.basename(self.files[0].path).lower().startswith("mmproj"))

    @property
    def size(self) -> int:
        return sum(f.size for f in self.files)


def group_files(files: list[FileRec]) -> dict[str, list[Group]]:
    by_dir: dict[str, dict[tuple, list]] = defaultdict(lambda: defaultdict(list))
    for f in files:
        d, name = os.path.split(f.path)
        if name.lower().endswith(".bin") and os.path.exists(f.path[:-4] + ".cue"):
            continue  # a CD image, not weights
        if is_partial(name):
            key = ("partial",)
        elif m := SHARD_RE.match(name):
            key = ("shard", m["prefix"], m["ext"].lower())
        else:
            key = ("single", name)
        by_dir[d][key].append(f)
    return {d: [Group(d, k, sorted(fs, key=lambda f: f.path)) for k, fs in g.items()]
            for d, g in by_dir.items()}


def measure_dir(d: str, mounts_or_protected: set) -> tuple[bool, int]:
    """(ok, allocated bytes) for everything under d, giving up on huge trees."""
    total, n = 0, 0
    for root, dirs, files in os.walk(d):
        if any(os.path.join(root, x) in mounts_or_protected for x in dirs):
            return False, 0
        for x in files:
            n += 1
            if n > FOLDER_MAX_FILES:
                return False, 0
            try:
                total += os.lstat(os.path.join(root, x)).st_blocks * 512
            except OSError:
                pass
    return True, total


def sig_name(path: str) -> str:
    """File name for duplicate matching; generic names (dense.bin) keep their folder."""
    d, base = os.path.split(path)
    stem = os.path.splitext(base)[0].lower()
    if stem in GENERIC_STEMS or SHARD_RE.match(base) and SHARD_RE.match(base)["prefix"].lower() in GENERIC_STEMS:
        return f"{os.path.basename(d)}/{base}"
    return base


def model_from_files(name, kind, path, is_dir, recs: list[FileRec], size, sig_recs) -> Model:
    return Model(
        key=path, name=name, kind=kind, path=path, is_dir=is_dir,
        files=[f.path for f in recs], nfiles=len(recs), size=size,
        frees=size - sum(f.size for f in recs if f.nlink > 1),
        last_used=max(max(f.atime, f.mtime) for f in recs),
        mtime=max(f.mtime for f in recs), dev=recs[0].dev,
        signature=sorted([sig_name(f.path), f.apparent] for f in sig_recs))


def build_models(files: list[FileRec], protected: set) -> list[Model]:
    groups = group_files(files)
    # Count primary GGUF groups in every subtree: a folder holding two
    # different quants is a collection, not one model.
    gguf_in = Counter()
    for d, gs in groups.items():
        c = sum(g.primary_gguf for g in gs)
        p = d
        while c:
            gguf_in[p] += c
            parent = os.path.dirname(p)
            if parent == p:
                break
            p = parent

    folders: list[str] = []
    for d in sorted(groups, key=lambda x: x.count("/")):
        if any(d.startswith(f + "/") for f in folders):
            continue
        if all(g.partial for g in groups[d]):
            continue
        if (d in protected or d.count("/") < 2 or gguf_in[d] > 1
                or os.path.basename(d).lower() in NEVER_FOLDER_UNIT
                or os.path.dirname(d) == HOME or os.path.exists(os.path.join(d, ".git"))):
            continue
        # Weights in subfolders are only absorbed if they look like parts of this
        # model; a sibling model moved into the same folder must stay separate.
        if any(os.path.relpath(gd, d).split("/")[0].lower() not in AUX_SUBDIRS
               for gd, gs in groups.items()
               if gd.startswith(d + "/") and not all(g.partial for g in gs)):
            continue
        ok, total = measure_dir(d, protected)
        weights = sum(f.size for f in files if f.path.startswith(d + "/"))
        if ok and total and weights >= FOLDER_WEIGHT_SHARE * total:
            folders.append(d)

    models = []
    for d in folders:
        inner = [g for gd, gs in groups.items() if gd == d or gd.startswith(d + "/") for g in gs]
        recs = [f for g in inner for f in g.files]
        main = max(inner, key=lambda g: g.size)
        base = os.path.basename(d)
        if main.primary_gguf:
            name = main.stem  # the file name carries the quant; folder names often don't
        elif base.lower() in GENERIC_DIR_NAMES or QUANT_RE.match(base):
            name = f"{os.path.basename(os.path.dirname(d))}/{base}"
        else:
            name = base
        _, total = measure_dir(d, protected)
        models.append(model_from_files(name, main.kind, d, True, recs, total, main.files))

    for d, gs in groups.items():
        if any(d == f or d.startswith(f + "/") for f in folders):
            continue
        for g in gs:
            models.append(model_from_files(g.stem, g.kind, g.files[0].path, False, g.files,
                                           g.size, g.files))
    return models


def hf_model(d: str) -> Model | None:
    """A Hugging Face hub cache repo (models--org--name)."""
    total, blobs, exts = 0, [], Counter()
    for root, _, names in os.walk(d):
        for x in names:
            p = os.path.join(root, x)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if stat.S_ISLNK(st.st_mode):
                exts[os.path.splitext(x)[1].lower()] += 1
            elif stat.S_ISREG(st.st_mode):
                total += st.st_blocks * 512
                if os.path.basename(root) == "blobs":
                    blobs.append(FileRec(p, st.st_blocks * 512, st.st_size, st.st_atime,
                                         st.st_mtime, st.st_dev, st.st_ino, st.st_nlink))
    if not blobs:
        return None
    kind = next((KIND_BY_EXT[e] for e, _ in exts.most_common() if e in KIND_BY_EXT), "weights")
    m = model_from_files(os.path.basename(d)[len("models--"):].replace("--", "/", 1), kind,
                         d, True, blobs, total, blobs)
    m.source = "hf"
    return m


def _manifest_digests(path: Path) -> list[str]:
    data = json.loads(path.read_text())
    ds = [layer["digest"] for layer in data.get("layers", [])]
    if data.get("config", {}).get("digest"):
        ds.append(data["config"]["digest"])
    return ds


def ollama_manifests(store: str) -> dict[Path, list[str]]:
    out = {}
    for p in (Path(store) / "manifests").rglob("*"):
        try:
            if p.is_file():
                out[p] = _manifest_digests(p)
        except (OSError, ValueError, KeyError, TypeError):
            pass
    return out


def ollama_models(store: str) -> list[Model]:
    manifests = ollama_manifests(store)
    refs = Counter(d for ds in manifests.values() for d in set(ds))
    mdir, bdir = Path(store) / "manifests", Path(store) / "blobs"
    models = []
    for mpath, digests in manifests.items():
        parts = mpath.relative_to(mdir).parts
        if len(parts) < 2:
            continue
        *repo, tag = parts
        if repo[:2] == ["registry.ollama.ai", "library"]:
            repo = repo[2:]
        elif repo[:1] == ["registry.ollama.ai"]:
            repo = repo[1:]
        name = f"{'/'.join(repo)}:{tag}"
        recs, frees = [], 0
        for dg in dict.fromkeys(digests):
            bp = bdir / dg.replace(":", "-")
            try:
                st = bp.stat()
            except OSError:
                continue
            recs.append(FileRec(str(bp), st.st_blocks * 512, st.st_size, st.st_atime,
                                st.st_mtime, st.st_dev, st.st_ino, st.st_nlink))
            if refs[dg] == 1:
                frees += st.st_blocks * 512
        if not recs:
            continue
        big = max(recs, key=lambda f: f.size)
        m = model_from_files(name, "gguf", str(mpath), False, recs, sum(f.size for f in recs), [big])
        m.key = f"ollama:{mpath}"
        m.source, m.frees = "ollama", frees
        m.last_used = max(f.atime for f in recs)
        m.extra = {"store": store, "manifest": str(mpath), "name": name,
                   "sizes": {f.path: f.size for f in recs}}
        models.append(m)
    return models


def attach_links(models: list[Model], links: list[str]) -> None:
    by_file = {f: m for m in models for f in m.files}
    folders = sorted((m for m in models if m.is_dir), key=lambda m: -len(m.path))
    for m in models:
        m.links = []
    for link in links:
        try:
            target = os.path.realpath(link)
        except OSError:
            continue
        m = by_file.get(target)
        if m is None:
            m = next((f for f in folders if target == f.path or target.startswith(f.path + "/")), None)
        if m is not None and not (m.is_dir and link.startswith(m.path + "/")):
            m.links.append(link)


# ─── runtime facts: who has it open, which units mention it, copies ──────────

def open_weight_files() -> dict[str, set]:
    """path -> {"comm[pid]"} for every weight file a readable process has open or mapped."""
    users: dict[str, set] = defaultdict(set)
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        base = f"/proc/{pid}"
        paths = set()
        try:
            for fd in os.listdir(base + "/fd"):
                try:
                    paths.add(os.readlink(f"{base}/fd/{fd}"))
                except OSError:
                    pass
        except OSError:
            pass
        try:
            with open(base + "/maps") as f:
                for line in f:
                    i = line.find("/")
                    if i != -1:
                        paths.add(line[i:].rstrip("\n").removesuffix(" (deleted)"))
        except OSError:
            pass
        paths = {p for p in paths if p.startswith("/") and
                 (looks_weight(os.path.basename(p)) or "/blobs/" in p)}
        if not paths:
            continue
        try:
            comm = Path(base, "comm").read_text().strip()
        except OSError:
            comm = "?"
        for p in paths:
            users[p].add(f"{comm}[{pid}]")
    return users


def users_of(m: Model, omap: dict[str, set]) -> list[str]:
    found = set()
    if m.is_dir:
        prefix = m.path + "/"
        for p, us in omap.items():
            if p.startswith(prefix):
                found |= us
    for f in m.files:
        found |= omap.get(f, set())
    return sorted(found)


def unit_texts() -> dict[str, tuple[str, list[str]]]:
    """systemd unit name -> (its text plus any scripts/env files it runs, the
    folders relative paths in that text are likely relative to)."""
    out = {}
    for d in ("/etc/systemd/system", os.path.join(HOME, ".config/systemd/user")):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            p = os.path.join(d, name)
            if not name.endswith(".service") or not os.path.isfile(p) \
                    or os.path.realpath(p) == "/dev/null":
                continue
            try:
                text = Path(p).read_text(errors="replace")
            except OSError:
                continue
            parts, bases = [text], []
            for line in text.splitlines():
                k, _, v = line.partition("=")
                k = k.strip()
                if k == "WorkingDirectory":
                    bases.append(v.strip().lstrip("-"))
                if k not in ("ExecStart", "ExecStartPre", "ExecStartPost", "EnvironmentFile"):
                    continue
                for tok in v.split():
                    tok = tok.lstrip("-+@!:")
                    try:
                        if tok.startswith("/") and os.path.isfile(tok) and os.path.getsize(tok) < 512_000:
                            data = Path(tok).read_bytes()
                            if b"\0" not in data[:4096]:
                                parts.append(data.decode(errors="replace"))
                                bases.append(os.path.dirname(tok))
                    except OSError:
                        pass
            blob = "\n".join(parts)
            blob = blob.replace("${HOME}", HOME).replace("$HOME", HOME).replace("~/", HOME + "/")
            out[name] = (blob, [b for b in bases if b.startswith("/")])
    return out


def needles(m: Model) -> tuple[list[str], list[str]]:
    """(exact path forms, loose name forms) a script might use to refer to m."""
    if m.source == "ollama":
        return [m.extra.get("name", m.name)], []
    if m.is_dir:
        base = os.path.basename(m.path)
        loose = [base] if len(base) >= 8 and base.lower() not in GENERIC_DIR_NAMES \
            and not QUANT_RE.match(base) else []
        return [m.path], loose
    first = os.path.basename(m.files[0])
    sm = SHARD_RE.match(first)
    name = sm["prefix"] + "-" if sm else first
    return [os.path.join(os.path.dirname(m.files[0]), name)], [name]


def service_refs(models: list[Model]) -> dict[str, list[str]]:
    """key -> units that mention the model. A unit that names one copy by path
    doesn't also count as using other copies that merely share its file name."""
    refs = {m.key: [] for m in models}
    forms = {m.key: needles(m) for m in models}
    for unit, (text, bases) in unit_texts().items():
        exact = set()
        for m in models:
            ex, _ = forms[m.key]
            rel = [os.path.relpath(e, b) for e in ex for b in bases]
            if any(e in text for e in ex) or any(not r.startswith("..") and r in text for r in rel):
                exact.add(m.key)
        claimed = {n for m in models if m.key in exact for n in forms[m.key][1]}
        for m in models:
            loose = forms[m.key][1]
            if m.key in exact or (any(n in text for n in loose) and not set(loose) & claimed):
                refs[m.key].append(unit)
    return refs


def unit_states(units: list[str]) -> dict[str, str]:
    if not units:
        return {}
    try:
        out = subprocess.run(["systemctl", "is-active", *units], capture_output=True,
                             text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return {}
    return dict(zip(units, out))


def annotate(models: list[Model]) -> dict[str, tuple]:
    """key -> (users, services, writable). Safe to run off the main thread."""
    omap = open_weight_files()
    refs = service_refs(models)
    states = unit_states(sorted({u for us in refs.values() for u in us}))
    out = {}
    for m in models:
        if m.source == "ollama":
            store = m.extra.get("store", "")
            writable = os.access(os.path.join(store, "blobs"), os.W_OK) or bool(shutil.which("ollama"))
        else:
            writable = os.access(os.path.dirname(m.path), os.W_OK) and \
                (not m.is_dir or os.access(m.path, os.W_OK))
        out[m.key] = (users_of(m, omap), [(u, states.get(u, "?")) for u in refs[m.key]], writable)
    return out


def model_bytes(models: list[Model]) -> int:
    """Space the models occupy, counting blobs shared between Ollama tags once."""
    total, blobs = 0, {}
    for m in models:
        if m.source == "ollama" and "sizes" in m.extra:
            blobs.update(m.extra["sizes"])
        else:
            total += m.size
    return total + sum(blobs.values())


def mark_bulk(models: list[Model], window: float = 60, min_cluster: int = 4) -> None:
    """Flag models whose last-use time is shared with several others: something
    read them all at once (a backup, Ollama's startup scan), so atime only tells
    us the real last use was no later than that."""
    for m in models:
        m.bulk = 0
    ms = sorted((m for m in models if m.last_used), key=lambda m: m.last_used)
    i = 0
    while i < len(ms):
        j = i
        while j + 1 < len(ms) and ms[j + 1].last_used - ms[j].last_used <= window:
            j += 1
        if j - i + 1 >= min_cluster:
            for m in ms[i:j + 1]:
                m.bulk = j - i
        i = j + 1


def mark_dups(models: list[Model]) -> None:
    by_sig = defaultdict(list)
    for m in models:
        if m.signature and m.source != "ollama":
            by_sig[tuple(tuple(x) for x in m.signature)].append(m)
    for m in models:
        m.dups = []
    for ms in by_sig.values():
        if len(ms) > 1:
            for m in ms:
                m.dups = [o.path for o in ms if o is not m]


