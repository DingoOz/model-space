class StackBar(Widget):
    """A stacked horizontal bar that fills its width."""

    DEFAULT_CSS = "StackBar { height: 1; }"

    def __init__(self, rows: int = 1, **kw):
        super().__init__(**kw)
        self.rows = rows
        self.segments: list = []
        self.total = 1.0
        self.styles.height = rows

    def set(self, segments, total) -> None:
        self.segments, self.total = segments, total
        self.refresh()

    def render(self) -> Text:
        line = bar_text(self.size.width, self.segments, self.total)
        out = Text()
        for i in range(self.rows):
            if i:
                out.append("\n")
            out.append_text(line)
        return out


def legend(p, items) -> Text:
    t = Text()
    for i, (label, value, style) in enumerate(items):
        if i:
            t.append("    ")
        t.append("■ ", style=style)
        t.append(f"{label} ", style=p.muted)
        t.append(human(value), style=f"bold {p.fg}")
    return t


class DiskCard(Vertical):
    def __init__(self, disk: Disk):
        super().__init__()
        self.disk = disk

    def compose(self) -> ComposeResult:
        yield Static(classes="card-sub")
        yield StackBar(rows=2, classes="card-bar")
        yield Static(classes="card-legend")
        yield Static(classes="card-models")

    def set_data(self, disk: Disk, models: list[Model]) -> None:
        self.disk = disk
        p = palette(self.app)
        frac = disk.frac
        msize = min(model_bytes(models), disk.used)
        self.border_title = f" {disk.mount} "
        self.border_subtitle = f" {frac * 100:.0f}% used · {human(disk.free)} free "
        self.set_class(frac >= 0.9, "crit")
        self.set_class(0.75 <= frac < 0.9, "warn")
        self.query_one(".card-sub", Static).update(
            Text(f"{disk.device} · {disk.fstype}" + (f" · {disk.label}" if disk.label else ""),
                 style=p.muted, no_wrap=True, overflow="ellipsis"))
        self.query_one(StackBar).set(
            [(msize, p.accent, "█"), (disk.used - msize, p.secondary, "█"), (disk.free, p.track, "░")],
            disk.used + disk.free)
        self.query_one(".card-legend", Static).update(legend(p, [
            ("models", msize, p.accent), ("other", disk.used - msize, p.secondary),
            ("free", disk.free, p.track), ("size", disk.total, p.muted)]))
        t = Text(no_wrap=True, overflow="ellipsis")
        if models:
            t.append(f"{len(models)} models", style=f"bold {p.accent}")
            t.append(" · largest:", style=p.muted)
            for m in sorted(models, key=lambda m: -m.size)[:4]:
                t.append(f"\n{human(m.size):>10}  ", style=f"bold {p.fg}")
                t.append(m.name, style=p.fg)
                t.append(f"  {ago(m.last_used)}", style=age_style(p, m.last_used))
        else:
            t.append("no models found here", style=p.muted)
        self.query_one(".card-models", Static).update(t)


class StorageView(VerticalScroll):
    def compose(self) -> ComposeResult:
        with Vertical(id="overview"):
            yield Static(id="overview-head")
            yield StackBar(rows=1, id="overview-bar")
            yield Static(id="overview-legend")
            yield Static(id="overview-alerts")
        yield Vertical(id="cards")

    def on_resize(self) -> None:
        self.query_one("#cards").styles.grid_size_columns = 2 if self.size.width >= 130 else 1

    def refresh_data(self, disks: list[Disk], models: list[Model], scanning: bool) -> None:
        p = palette(self.app)
        cards = self.query_one("#cards")
        existing = {c.disk.dev: c for c in cards.query(DiskCard)}
        if set(existing) != {d.dev for d in disks}:
            cards.remove_children()
            existing = {d.dev: DiskCard(d) for d in disks}
            cards.mount(*existing.values())
            self.call_after_refresh(self.refresh_data, disks, models, scanning)
            return
        for d in disks:
            existing[d.dev].set_data(d, [m for m in models if m.dev == d.dev])

        used = sum(d.used for d in disks)
        free = sum(d.free for d in disks)
        msize = min(model_bytes([m for m in models if any(m.dev == d.dev for d in disks)]), used)
        self.query_one("#overview").border_title = " All storage "
        head = Text()
        head.append(human(used + free), style=f"bold {p.fg}")
        head.append(f" across {len(disks)} filesystems   ", style=p.muted)
        head.append(f"{used / ((used + free) or 1) * 100:.0f}% used", style=f"bold {level_style(p, used / ((used + free) or 1))}")
        head.append("   ·   ", style=p.muted)
        head.append(f"{len(models)} models", style=f"bold {p.accent}")
        head.append(f" taking {human(msize)}", style=p.fg)
        if scanning:
            head.append("   (scanning…)", style=f"italic {p.muted}")
        self.query_one("#overview-head", Static).update(head)
        self.query_one("#overview-bar", StackBar).set(
            [(msize, p.accent, "█"), (used - msize, p.secondary, "█"), (free, p.track, "░")], used + free)
        self.query_one("#overview-legend", Static).update(legend(p, [
            ("models", msize, p.accent), ("other", used - msize, p.secondary), ("free", free, p.track)]))
        alerts = Text()
        for d in disks:
            if d.frac >= 0.9:
                if alerts:
                    alerts.append("\n")
                alerts.append("▲ ", style=p.err)
                alerts.append(f"{d.mount} is {d.frac * 100:.0f}% full", style=f"bold {p.err}")
                alerts.append(f" — {human(d.free)} left. ", style=p.fg)
                alerts.append("2 moves models off it, 3 cleans up old ones.", style=p.muted)
        self.query_one("#overview-alerts", Static).update(alerts)
        self.query_one("#overview-alerts").display = bool(alerts)


class ModelList(Vertical):
    """Filter bar, model table and details pane; subclasses add columns and actions."""

    BINDINGS = [
        Binding("space", "toggle_row", "Select"),
        Binding("a", "select_all", "All"),
        Binding("n", "select_none", "None"),
        Binding("slash", "focus_filter", "Filter"),
    ]
    COLUMNS: list = []
    sort_by = "size"
    sort_reverse = True

    def __init__(self, **kw):
        super().__init__(**kw)
        self.selected: set[str] = set()
        self.rows: list[Model] = []
        self.disk_filter = "*"
        self.text_filter = ""

    # subclass hooks
    def compose_filters(self) -> ComposeResult:
        yield from ()

    def compose_side(self) -> ComposeResult:
        yield from ()

    def compose_bottom(self) -> ComposeResult:
        yield from ()

    def extra_visible(self, m: Model) -> bool:
        return True

    def cells(self, m: Model, p) -> list:
        raise NotImplementedError

    def summary_changed(self) -> None:
        pass

    def compose(self) -> ComposeResult:
        with Horizontal(classes="body"):
            with Vertical(classes="main"):
                with Horizontal(classes="filters"):
                    yield Input(placeholder="Filter by name or path…   ( / )", classes="filter")
                    yield Select([("All disks", "*")], value="*", allow_blank=False, classes="disk-filter")
                    yield from self.compose_filters()
                yield DataTable(cursor_type="row", zebra_stripes=True)
                yield Static(classes="details")
                yield from self.compose_bottom()
            yield from self.compose_side()

    def on_mount(self) -> None:
        t = self.query_one(DataTable)
        for label, key, width in self.COLUMNS:
            t.add_column(label, key=key, width=width)

    @property
    def table(self) -> DataTable:
        return self.query_one(DataTable)

    def sort_value(self, m: Model):
        return {"size": m.size, "name": m.name.lower(), "used": m.last_used, "idle": -m.last_used,
                "disk": self.app.mount_of(m), "loc": m.path, "fmt": m.format_label,
                "flags": (bool(m.users), bool(m.services), bool(m.dups))}.get(self.sort_by, m.size)

    def matches(self, m: Model) -> bool:
        if self.disk_filter != "*" and str(m.dev) != self.disk_filter:
            return False
        if self.text_filter:
            hay = f"{m.name} {m.path} {m.format_label}".lower()
            if not all(w in hay for w in self.text_filter.lower().split()):
                return False
        return self.extra_visible(m)

    def set_disks(self, disks: list[Disk]) -> None:
        sel = self.query_one(".disk-filter", Select)
        opts = [("All disks", "*")] + [(d.mount, str(d.dev)) for d in disks]
        value = self.disk_filter if any(v == self.disk_filter for _, v in opts) else "*"
        with sel.prevent(Select.Changed):
            sel.set_options(opts)
            sel.value = value
        self.disk_filter = value

    def current(self) -> Model | None:
        t = self.table
        if not self.rows or t.cursor_row is None or t.cursor_row >= len(self.rows):
            return None
        return self.rows[t.cursor_row]

    def rebuild(self) -> None:
        t = self.table
        cur = self.current()
        cur_key = cur.key if cur else None
        p = palette(self.app)
        keys = {m.key for m in self.app.models}
        self.selected &= keys
        self.rows = sorted((m for m in self.app.models if self.matches(m)),
                           key=self.sort_value, reverse=self.sort_reverse)
        t.clear()
        for m in self.rows:
            t.add_row(*self.cells(m, p), key=m.key)
        if cur_key:
            idx = next((i for i, m in enumerate(self.rows) if m.key == cur_key), None)
            if idx is not None:
                t.move_cursor(row=idx, animate=False)
        self.show_details()
        self.summary_changed()

    def redraw_row(self, m: Model) -> None:
        p = palette(self.app)
        for (_, key, _), value in zip(self.COLUMNS, self.cells(m, p)):
            self.table.update_cell(m.key, key, value)

    def styled(self, m: Model, value, style: str = "") -> Text:
        t = value if isinstance(value, Text) else Text(str(value), style=style)
        if m.key in self.selected:
            t.stylize("bold")
        return t

    def mark(self, m: Model, p) -> Text:
        return Text("✔", style=f"bold {p.accent}") if m.key in self.selected else Text("·", style=p.muted)

    def flags(self, m: Model, p) -> Text:
        t = Text()
        if m.users:
            t.append("● in use ", style=f"bold {p.err}")
        if m.services:
            active = any(s == "active" for _, s in m.services)
            t.append("svc ", style=f"bold {p.warn}" if active else p.warn)
        if m.dups:
            t.append("dup ", style=p.primary)
        if m.links:
            t.append("↩link ", style=p.secondary)
        if not m.writable:
            t.append("ro ", style=p.muted)
        if m.kind == "partial":
            t.append("partial ", style=p.warn)
        return t

    def show_details(self) -> None:
        m = self.current()
        box = self.query_one(".details", Static)
        if m is None:
            box.update(Text("No models match.", style=palette(self.app).muted))
            return
        p = palette(self.app)
        t = Text(no_wrap=True, overflow="ellipsis")
        t.append(m.name, style=f"bold {p.fg}")
        t.append(f"   {m.format_label} · {m.nfiles} file{'s' * (m.nfiles != 1)} · {human(m.size)}", style=p.fg)
        if m.frees != m.size:
            t.append(f" (deleting frees {human(m.frees)})", style=p.muted)
        t.append("\n")
        t.append(short_path(m.path) + ("/" if m.is_dir else ""), style=p.secondary)
        if m.is_dir:
            t.append("  (whole folder)", style=p.muted)
        elif m.nfiles > 1:
            t.append(f"  + {m.nfiles - 1} more part{'s' * (m.nfiles > 2)}", style=p.muted)
        t.append("\n")
        t.append("last used ", style=p.muted)
        t.append(time.strftime("%Y-%m-%d %H:%M", time.localtime(m.last_used)) if m.last_used else "never",
                 style=age_style(p, m.last_used))
        t.append(f" ({ago(m.last_used)})", style=p.muted)
        if m.bulk:
            t.append(f"  * read together with {m.bulk} other models then (a backup or scan?) — "
                     "real last use was no later", style=p.muted)
        t.append("   modified ", style=p.muted)
        t.append(time.strftime("%Y-%m-%d", time.localtime(m.mtime)), style=p.fg)
        notes = []
        if m.users:
            notes.append((f"● open by {', '.join(m.users)}", p.err))
        for u, s in m.services:
            notes.append((f"referenced by {u} ({s})", p.warn))
        for d in m.dups:
            notes.append((f"copy also at {short_path(d)}", p.primary))
        for link in m.links[:3]:
            notes.append((f"symlink {short_path(link)}", p.secondary))
        if not m.writable:
            notes.append(("read-only for you", p.muted))
        if notes:
            t.append("\n")
            for i, (s, style) in enumerate(notes):
                if i:
                    t.append("  ·  ", style=p.muted)
                t.append(s, style=style)
        box.update(t)

    def targets(self) -> list[Model]:
        if self.selected:
            return [m for m in self.app.models if m.key in self.selected]
        cur = self.current()
        return [cur] if cur else []

    # events / actions
    @on(DataTable.RowHighlighted)
    def _highlighted(self) -> None:
        self.show_details()

    @on(DataTable.RowSelected)
    def _row_selected(self) -> None:
        self.action_toggle_row()

    @on(DataTable.HeaderSelected)
    def _header(self, event: DataTable.HeaderSelected) -> None:
        key = event.column_key.value
        if key == "mark":
            return
        if key == self.sort_by:
            self.sort_reverse = not self.sort_reverse
        else:
            self.sort_by, self.sort_reverse = key, key in ("size", "used", "flags")
        self.rebuild()

    @on(Input.Changed, ".filter")
    def _filter(self, event: Input.Changed) -> None:
        self.text_filter = event.value
        self.rebuild()

    @on(Input.Submitted, ".filter")
    def _filter_done(self) -> None:
        self.table.focus()

    @on(Select.Changed, ".disk-filter")
    def _disk(self, event: Select.Changed) -> None:
        self.disk_filter = str(event.value)
        self.rebuild()

    def action_toggle_row(self) -> None:
        m = self.current()
        if m is None:
            return
        self.selected ^= {m.key}
        self.redraw_row(m)
        t = self.table
        if t.cursor_row < len(self.rows) - 1:
            t.move_cursor(row=t.cursor_row + 1)
        self.summary_changed()

    def action_select_all(self) -> None:
        self.selected |= {m.key for m in self.rows}
        self.rebuild()

    def action_select_none(self) -> None:
        self.selected.clear()
        self.rebuild()

    def action_focus_filter(self) -> None:
        self.query_one(".filter", Input).focus()


class MoveView(ModelList):
    BINDINGS = [Binding("m", "move", "Move selected")]
    _programmatic_hl: str | None = None
    COLUMNS = [("", "mark", 1), ("Model", "name", 44), ("Format", "fmt", 15), ("Size", "size", 9),
               ("Disk", "disk", 11), ("Location", "loc", 32), ("Last used", "used", 10),
               ("Flags", "flags", 16)]

    def compose_side(self) -> ComposeResult:
        with Vertical(id="move-side"):
            yield Label("Destination disk", classes="side-title")
            yield OptionList(id="dest-disks")
            yield Label("Folder", classes="side-title")
            with Horizontal(id="dest-row"):
                yield Input(id="dest-path", placeholder="/path/to/folder")
                yield Button("…", id="browse", tooltip="Browse for a folder")
            yield Checkbox("Leave a symlink at the old location", value=True, id="leave-link")
            yield Static(id="move-summary")
            yield Button("Move selected  ▶", id="do-move", variant="primary")

    def cells(self, m: Model, p) -> list:
        return [self.mark(m, p),
                self.styled(m, Text(m.name, style=p.fg, overflow="ellipsis", no_wrap=True)),
                self.styled(m, m.format_label, p.muted),
                self.styled(m, Text(human(m.size), style=f"bold {p.fg}", justify="right")),
                self.styled(m, self.app.mount_of(m), p.secondary),
                self.styled(m, short_path(m.location, 32), p.muted),
                self.styled(m, used_label(m), age_style(p, m.last_used)),
                self.flags(m, p)]

    def on_resize(self) -> None:
        self.call_after_refresh(self.refresh_dest_disks)

    def dest_disk(self) -> Disk | None:
        path = self.query_one("#dest-path", Input).value.strip()
        return disk_for_path(self.app.disks, os.path.expanduser(path)) if path else None

    def suggest_dest(self, d: Disk) -> str:
        saved = self.app.config.get("dest", {}).get(d.mount)
        if saved:
            return saved
        return os.path.join(HOME, "models") if d.mount == "/" else d.mount

    def refresh_dest_disks(self) -> None:
        ol = self.query_one("#dest-disks", OptionList)
        p = palette(self.app)
        sel = self.targets() if self.selected else []
        width = ol.scrollable_content_region.width - 2 if ol.size.width else 38
        width = max(20, width)
        opts = []
        for d in self.app.disks:
            if d.mount in NO_SCAN_MOUNTS:
                continue
            incoming = sum(m.size for m in sel if m.dev != d.dev and m.source != "ollama")
            fits = d.free - incoming > FREE_MARGIN
            t = Text(no_wrap=True, overflow="ellipsis")
            free_s = f"{human(d.free)} free"
            t.append(f"{d.mount:<{max(1, width - len(free_s))}}", style=f"bold {p.fg}")
            t.append(free_s, style=level_style(p, d.frac))
            t.append("\n")
            t.append_text(bar_text(width, [(d.used, p.secondary, "━"),
                                           (min(incoming, d.free), p.accent if fits else p.err, "━"),
                                           (max(0, d.free - incoming), p.track, "━")], d.used + d.free))
            if incoming:
                t.append("\n")
                t.append("after move  ", style=p.muted)
                if fits:
                    after = (d.used + incoming) / (d.used + d.free)
                    t.append(f"{human(d.free - incoming)} free · {after * 100:.0f}% used",
                             style=level_style(p, after))
                else:
                    t.append(f"won't fit — {human(incoming - d.free + FREE_MARGIN)} short", style=f"bold {p.err}")
            opts.append(Option(t, id=str(d.dev)))
        hi = ol.highlighted
        path_input = self.query_one("#dest-path", Input)
        cur = self.dest_disk()
        ol.clear_options()
        ol.add_options(opts)
        if not opts:
            return
        # Keep the highlight on the disk the folder is on; rebuilding the list
        # must never rewrite a folder the user typed.
        ids = [o.id for o in opts]
        idx = ids.index(str(cur.dev)) if cur and str(cur.dev) in ids else \
            hi if hi is not None and hi < len(opts) else 0
        self._programmatic_hl = ids[idx]
        ol.highlighted = idx
        if not path_input.value.strip():
            d = next(d for d in self.app.disks if str(d.dev) == ids[idx])
            path_input.value = self.suggest_dest(d)

    @on(OptionList.OptionHighlighted, "#dest-disks")
    def _dest_disk(self, event: OptionList.OptionHighlighted) -> None:
        if event.option.id == self._programmatic_hl:
            self._programmatic_hl = None
            return  # our own re-highlight after a rebuild, not the user picking a disk
        d = next((d for d in self.app.disks if str(d.dev) == event.option.id), None)
        cur = self.dest_disk()
        if d and (cur is None or cur.dev != d.dev):
            self.query_one("#dest-path", Input).value = self.suggest_dest(d)

    @on(Input.Changed, "#dest-path")
    def _dest_changed(self) -> None:
        self.summary_changed()

    @on(Checkbox.Changed, "#leave-link")
    def _link_changed(self) -> None:
        self.summary_changed()

    def summary_changed(self) -> None:
        self.refresh_dest_disks()
        p = palette(self.app)
        sel = self.targets() if self.selected else []
        box = self.query_one("#move-summary", Static)
        t = Text()
        if not sel:
            t.append("Select models with space, then pick a disk and folder.", style=p.muted)
            box.update(t)
            return
        d = self.dest_disk()
        t.append(f"{len(sel)} selected · {human(sum(m.size for m in sel))}\n", style=f"bold {p.fg}")
        if d is None:
            t.append("Pick a destination.", style=p.warn)
            box.update(t)
            return
        rename = [m for m in sel if m.dev == d.dev]
        copy = [m for m in sel if m.dev != d.dev and m.source != "ollama"]
        if copy:
            t.append(f"copy {human(sum(m.size for m in copy))} → {d.mount}\n", style=p.accent)
        if rename:
            t.append(f"{len(rename)} on the same disk (instant rename)\n", style=p.ok)
        blocked = [m for m in sel if m.users or m.source == "ollama" or not m.writable]
        if blocked:
            t.append(f"{len(blocked)} will be skipped (in use / Ollama / read-only)\n", style=p.warn)
        svc = [m for m in sel if m.services]
        if svc and not self.query_one("#leave-link", Checkbox).value:
            t.append(f"⚠ {len(svc)} referenced by systemd units — keep the symlink on", style=p.err)
        box.update(t)

    @on(Button.Pressed, "#browse")
    def _browse(self) -> None:
        d = self.dest_disk() or (self.app.disks[0] if self.app.disks else None)
        start = self.query_one("#dest-path", Input).value.strip() or (d.mount if d else "/")
        while start and not os.path.isdir(start):
            start = os.path.dirname(start)
        root = d.mount if d and d.mount != "/" else HOME if start.startswith(HOME) else "/"

        def chosen(path: str | None) -> None:
            if path:
                self.query_one("#dest-path", Input).value = path
        self.app.push_screen(DirPicker(root), chosen)

    @on(Button.Pressed, "#do-move")
    def _do_move(self) -> None:
        self.action_move()

    def action_move(self) -> None:
        models = self.targets()
        if not models:
            self.app.notify("Nothing selected.", severity="warning")
            return
        dest = self.query_one("#dest-path", Input).value.strip()
        if not dest:
            self.app.notify("Pick a destination folder first.", severity="warning")
            return
        self.app.confirm_move(models, dest, self.query_one("#leave-link", Checkbox).value)


