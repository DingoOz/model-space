def human(n: float) -> str:
    n = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            break
        n /= 1024
    if unit == "B":
        return f"{int(n)} B"
    return f"{n:.1f} {unit}" if abs(n) < 100 else f"{n:.0f} {unit}"


def parse_size(s: str) -> int:
    m = re.fullmatch(r"\s*([\d.]+)\s*([kmgt]?)i?b?\s*", s.lower())
    if not m:
        raise argparse.ArgumentTypeError(f"bad size: {s!r}")
    return int(float(m[1]) * 1024 ** " kmgt".index(m[2] or " "))


def days_since(ts: float) -> float:
    return max(0.0, (time.time() - ts) / 86400) if ts else 1e9


def ago(ts: float) -> str:
    if not ts:
        return "never"
    d = days_since(ts)
    if d < 1:
        return "today"
    if d < 2:
        return "yesterday"
    if d < 14:
        return f"{int(d)}d ago"
    if d < 60:
        return f"{int(d / 7)}w ago"
    if d < 730:
        return f"{int(d / 30.4)}mo ago"
    return f"{d / 365:.1f}y ago"


def used_label(m) -> str:
    return ago(m.last_used) + ("*" if m.bulk else "")


def short_path(p: str, width: int = 0) -> str:
    if p == HOME or p.startswith(HOME + "/"):
        p = "~" + p[len(HOME):]
    if width and len(p) > width:
        p = "…" + p[-(width - 1):]
    return p


def bar_text(width: int, segments, total: float) -> Text:
    """One line of a stacked bar. segments: [(value, style, char)]."""
    t = Text()
    if width <= 0:
        return t
    if not segments or not any(v > 0 for v, _, _ in segments):
        return Text(" " * width)
    total = total or 1
    raw = [max(0.0, v) / total * width for v, _, _ in segments]
    cells = [int(r) for r in raw]
    # Anything non-zero gets at least one cell, then hand out the remainder.
    for i, (v, _, _) in enumerate(segments):
        if v > 0 and cells[i] == 0 and raw[i] > 0.05:
            cells[i] = 1
    while sum(cells) < width:
        i = max(range(len(raw)), key=lambda j: raw[j] - cells[j])
        cells[i] += 1
    while sum(cells) > width:
        i = max(range(len(cells)), key=lambda j: cells[j])
        cells[i] -= 1
    for n, (_, style, ch) in zip(cells, segments):
        if n:
            t.append(ch * n, style=style)
    return t


