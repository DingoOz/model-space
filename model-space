def level_style(p, frac: float) -> str:
    return p.err if frac >= 0.9 else p.warn if frac >= 0.75 else p.ok


def age_style(p, ts: float) -> str:
    d = days_since(ts)
    return p.ok if d < 7 else p.secondary if d < 30 else p.warn if d < 90 else p.err


# ─── disks ───────────────────────────────────────────────────────────────────

@dataclass
class Disk:
    mount: str
    device: str
    fstype: str
    dev: int
    total: int
    used: int
    free: int
    label: str = ""

    @property
    def frac(self) -> float:
        return self.used / ((self.used + self.free) or 1)

    def refresh(self) -> None:
        try:
            v = os.statvfs(self.mount)
        except OSError:
            return
        self.total = v.f_blocks * v.f_frsize
        self.used = (v.f_blocks - v.f_bfree) * v.f_frsize
        self.free = v.f_bavail * v.f_frsize


def _unescape(s: str) -> str:
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), s)


def mount_points() -> set[str]:
    pts = set()
    with open("/proc/self/mounts") as f:
        for line in f:
            parts = line.split()
            if len(parts) > 1:
                pts.add(_unescape(parts[1]))
    return pts


_lsblk_cache: list | None = None


def describe_device(dev: str) -> str:
    """'Samsung SSD 990 PRO · NVMe SSD · nvme0n1' style description of a block device."""
    global _lsblk_cache
    if _lsblk_cache is None:
        try:
            out = subprocess.run(["lsblk", "-J", "-l", "-o", "PATH,KNAME,PKNAME,MODEL,ROTA,TRAN,TYPE"],
                                 capture_output=True, text=True, timeout=5).stdout
            _lsblk_cache = json.loads(out)["blockdevices"]
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            _lsblk_cache = []
    by_path = {d.get("path"): d for d in _lsblk_cache}
    by_kname = {d.get("kname"): d for d in _lsblk_cache}
    real = os.path.realpath(dev)
    d = by_path.get(dev) or by_path.get(real) or by_kname.get(os.path.basename(real))
    if not d:
        return ""
    chain = [d]
    while d.get("type") != "disk" and d.get("pkname") in by_kname:
        d = by_kname[d["pkname"]]
        chain.append(d)
    disk = chain[-1]
    bits = []
    if (disk.get("model") or "").strip():
        bits.append(disk["model"].strip())
    tran = (disk.get("tran") or "").lower()
    if tran == "nvme":
        bits.append("NVMe SSD")
    else:
        bits.append(("HDD" if disk.get("rota") in (True, 1, "1") else "SSD") + (f" ({tran.upper()})" if tran else ""))
    layers = [c.get("type", "") for c in chain[:-1]]
    if "lvm" in layers:
        bits.append("LVM")
    bits += [t.upper() for t in layers if t.startswith("raid")][:1]
    bits.append(disk.get("kname", ""))
    return " · ".join(b for b in bits if b)


def get_disks() -> list[Disk]:
    disks: dict[int, Disk] = {}
    with open("/proc/self/mounts") as f:
        for line in f:
            parts = line.split()
            if len(parts) < 3:
                continue
            dev, mnt, fstype = parts[0], _unescape(parts[1]), parts[2]
            if fstype not in REAL_FS or mnt.startswith("/snap/"):
                continue
            try:
                st, v = os.stat(mnt), os.statvfs(mnt)
            except OSError:
                continue
            if v.f_blocks == 0:
                continue
            if st.st_dev in disks and len(disks[st.st_dev].mount) <= len(mnt):
                continue
            fr = v.f_frsize
            disks[st.st_dev] = Disk(mnt, dev, fstype, st.st_dev, v.f_blocks * fr,
                                    (v.f_blocks - v.f_bfree) * fr, v.f_bavail * fr,
                                    describe_device(dev))
    return sorted(disks.values(), key=lambda d: (d.mount != "/", d.mount))


def disk_for_path(disks: list[Disk], path: str) -> Disk | None:
    """The disk a (possibly not yet existing) path would live on."""
    p = os.path.abspath(path)
    while not os.path.exists(p) and p != "/":
        p = os.path.dirname(p)
    try:
        dev = os.stat(p).st_dev
    except OSError:
        return None
    return next((d for d in disks if d.dev == dev), None)


