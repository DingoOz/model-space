        days = days_since(m.last_used)
        style = age_style(p, m.last_used)
        idle = bar_text(8, [(days, style, "▇"), (oldest - days, p.track, "▁")], oldest)
        idle.append(f" {int(days):>4}d" if days < 1e8 else "   ?", style=style)
        return [self.mark(m, p),
                self.styled(m, used_label(m), style),
                idle,
                self.styled(m, Text(m.name, style=p.fg, overflow="ellipsis", no_wrap=True)),
                self.styled(m, Text(human(m.size), style=f"bold {p.fg}", justify="right")),
                self.styled(m, self.app.mount_of(m), p.secondary),
                self.styled(m, short_path(m.location, 30), p.muted),
                self.flags(m, p)]

    @on(Select.Changed, "#age-filter")
    def _age(self, event: Select.Changed) -> None:
        self.min_age = int(event.value)
        self.rebuild()

    def summary_changed(self) -> None:
        p = palette(self.app)
        sel = [m for m in self.app.models if m.key in self.selected]
        t = Text()
        if not sel:
            t.append("Select models with space — or type a size and press ", style=p.muted)
            t.append("Pick oldest", style=f"bold {p.fg}")
            t.append(" to select the longest-unused ones.", style=p.muted)
        else:
            t.append(f"{len(sel)} selected · frees {human(sum(m.frees for m in sel))}", style=f"bold {p.fg}")
            by_disk = Counter()
            for m in sel:
                by_disk[m.dev] += m.frees
            for d in self.app.disks:
                if by_disk[d.dev]:
                    t.append(f"   {d.mount} ", style=p.secondary)
                    t.append(f"{human(d.free)} → {human(d.free + by_disk[d.dev])} free", style=p.ok)
            risky = [m for m in sel if m.users or m.services]
            if risky:
                t.append(f"   ⚠ {len(risky)} in use or referenced by a service", style=p.warn)
        self.query_one("#clean-summary", Static).update(t)

    @on(Button.Pressed, "#pick-oldest")
    @on(Input.Submitted, "#free-target")
    def _pick_oldest(self) -> None:
        raw = self.query_one("#free-target", Input).value.strip()
        try:
            target = float(raw) * (1 << 30)
        except ValueError:
            self.app.notify("Type how many GiB to free first.", severity="warning")
            return
        self.selected.clear()
        got = 0
        for m in sorted(self.rows, key=lambda m: m.last_used):
            if got >= target:
                break
            if m.users or m.services or not m.writable:
                continue
            self.selected.add(m.key)
            got += m.frees
        self.rebuild()
        scope = "" if self.disk_filter == "*" else f" on {next((d.mount for d in self.app.disks if str(d.dev) == self.disk_filter), '?')}"
        msg = f"Selected {len(self.selected)} models{scope}, freeing {human(got)}"
        if got < target:
            msg += f" — that's all that's safely deletable here (in-use and service-referenced models are skipped)"
        self.app.notify(msg)
        self.table.focus()

    @on(Button.Pressed, "#do-delete")
    def _do_delete(self) -> None:
        self.action_delete()

    def action_delete(self) -> None:
        models = self.targets()
        if not models:
            self.app.notify("Nothing selected.", severity="warning")
            return
        self.app.confirm_delete(models)


