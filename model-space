def load_json(p: Path, default):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return default


def save_json(p: Path, data) -> None:
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".tmp")
        tmp.write_text(json.dumps(data))
        tmp.replace(p)
    except OSError:
        pass


def load_cache() -> tuple[list[Model], float] | None:
    data = load_json(CACHE_FILE, None)
    if not data or data.get("version") != CACHE_VERSION:
        return None
    try:
        models = [Model.from_json(d) for d in data["models"]]
    except (TypeError, KeyError):
        return None
    models = [m for m in models if os.path.lexists(m.path) and not os.path.islink(m.path)]
    return models, data.get("scanned_at", 0)


def save_cache(models: list[Model], scanned_at: float) -> None:
    save_json(CACHE_FILE, {"version": CACHE_VERSION, "scanned_at": scanned_at,
                           "models": [m.to_json() for m in models]})


# ─── moving and deleting ─────────────────────────────────────────────────────

class Cancelled(Exception):
    pass


def _fadvise(fd: int, off: int, n: int, advice: int) -> None:
    try:
        os.posix_fadvise(fd, off, n, advice)
    except (OSError, AttributeError):
        pass


def copy_file(src: str, dst: str, progress, cancel: threading.Event) -> None:
    """Copy one file without polluting the page cache; keeps mode and times."""
    st = os.stat(src)
    size = st.st_size
    try:  # don't let our own read count as "use" if the move is cancelled
        fdi = os.open(src, os.O_RDONLY | getattr(os, "O_NOATIME", 0))
    except PermissionError:
        fdi = os.open(src, os.O_RDONLY)
    try:
        fdo = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            _fadvise(fdi, 0, 0, os.POSIX_FADV_SEQUENTIAL)
            if size:
                try:
                    os.posix_fallocate(fdo, 0, size)
                except OSError as e:
                    if e.errno == errno.ENOSPC:
                        raise
            off, unsynced, use_sendfile = 0, 0, True
            while off < size:
                if cancel.is_set():
                    raise Cancelled()
                n = min(CHUNK, size - off)
                if use_sendfile:
                    try:
                        k = os.sendfile(fdo, fdi, off, n)
                    except OSError as e:
                        if e.errno not in (errno.EINVAL, errno.ENOSYS, errno.EOPNOTSUPP):
                            raise
                        use_sendfile = False
                        continue
                else:
                    k = os.pwrite(fdo, os.pread(fdi, n, off), off)
                if k <= 0:
                    raise OSError(errno.EIO, f"short read from {src}")
                off += k
                unsynced += k
                progress(k)
                if unsynced >= SYNC_EVERY:
                    os.fdatasync(fdo)
                    _fadvise(fdo, 0, off, os.POSIX_FADV_DONTNEED)
                    _fadvise(fdi, 0, off, os.POSIX_FADV_DONTNEED)
                    unsynced = 0
            os.fdatasync(fdo)
            _fadvise(fdo, 0, 0, os.POSIX_FADV_DONTNEED)
            _fadvise(fdi, 0, 0, os.POSIX_FADV_DONTNEED)
            os.fchmod(fdo, stat.S_IMODE(st.st_mode))
        finally:
            os.close(fdo)
    finally:
        os.close(fdi)
    os.utime(dst, ns=(st.st_atime_ns, st.st_mtime_ns))
    if os.path.getsize(dst) != size:
        raise OSError(errno.EIO, f"size mismatch copying {src}")


def copy_tree(src: str, dst: str, progress, cancel: threading.Event) -> None:
    st = os.stat(src)
    os.mkdir(dst, 0o700)
    dir_meta = [(dst, st)]
    for root, dirs, files in os.walk(src):
        droot = os.path.join(dst, os.path.relpath(root, src))
        for name in dirs + files:
            s, t = os.path.join(root, name), os.path.join(droot, name)
            lst = os.lstat(s)
            if stat.S_ISLNK(lst.st_mode):
                os.symlink(os.readlink(s), t)
            elif stat.S_ISDIR(lst.st_mode):
                os.mkdir(t, 0o700)
                dir_meta.append((t, lst))
            elif stat.S_ISREG(lst.st_mode):
                copy_file(s, t, progress, cancel)
    for d, s in reversed(dir_meta):
        os.chmod(d, stat.S_IMODE(s.st_mode))
        os.utime(d, ns=(s.st_atime_ns, s.st_mtime_ns))


def tree_signature(p: str) -> tuple[int, int]:
    if not os.path.isdir(p) or os.path.islink(p):
        return 1, os.lstat(p).st_size
    n, total = 0, 0
    for root, dirs, files in os.walk(p):
        for name in files:
            lst = os.lstat(os.path.join(root, name))
            n += 1
            total += lst.st_size if stat.S_ISREG(lst.st_mode) else 0
    return n, total


def apparent_size(p: str) -> int:
    return tree_signature(p)[1]


def remove_path(p: str) -> None:
    if os.path.islink(p) or not os.path.isdir(p):
        os.unlink(p)
    else:
        shutil.rmtree(p)


def fsync_dir(d: str) -> None:
    try:
        fd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


@dataclass
class MoveItem:
    model: Model
    pairs: list           # [(src, dst)]
    same_fs: bool
    nbytes: int           # bytes that must be copied (0 for a rename)
    link_targets: dict    # symlink -> what it resolved to before the move


def plan_moves(models: list[Model], dest: str, disks: list[Disk]):
    """-> (items, skipped [(model, reason)], fatal error or None)"""
    dest = os.path.abspath(os.path.expanduser(dest))
    ddisk = disk_for_path(disks, dest)
    if ddisk is None:
        return [], [], f"Can't tell which disk {dest} is on."
    anc = dest
    while not os.path.exists(anc):
        anc = os.path.dirname(anc)
    if not os.path.isdir(anc):
        return [], [], f"{anc} is not a folder."
    if not os.access(anc, os.W_OK):
        return [], [], f"No write permission on {anc}."
    items, skipped, taken = [], [], set()
    for m in models:
        if m.source == "ollama":
            skipped.append((m, "Ollama manages its own store (set OLLAMA_MODELS to relocate it)"))
            continue
        if m.users:
            skipped.append((m, f"in use by {', '.join(m.users)}"))
            continue
        if not m.writable:
            skipped.append((m, f"no write permission on {m.location}"))
            continue
        srcs = [m.path] if m.is_dir else list(m.files)
        pairs = [(s, os.path.join(dest, os.path.basename(s))) for s in srcs]
        if all(os.path.dirname(s) == dest for s in srcs):
            skipped.append((m, "already in that folder"))
            continue
        if m.is_dir and (dest == m.path or dest.startswith(m.path + "/")):
            skipped.append((m, "destination is inside the model's own folder"))
            continue
        clash = next((d for _, d in pairs if os.path.lexists(d) or d in taken), None)
        if clash:
            skipped.append((m, f"{short_path(clash)} already exists"))
            continue
        missing = next((s for s in srcs if not os.path.lexists(s)), None)
        if missing:
            skipped.append((m, f"{short_path(missing)} no longer exists — rescan"))
            continue
        taken.update(d for _, d in pairs)
        same = m.dev == ddisk.dev
        nbytes = 0 if same else sum(apparent_size(s) for s in srcs)
        targets = {}
        for link in m.links:
            try:
                targets[link] = os.path.realpath(link)
            except OSError:
                pass
        items.append(MoveItem(m, pairs, same, nbytes, targets))
    need = sum(i.nbytes for i in items)
    if need and need > ddisk.free - FREE_MARGIN:
        return items, skipped, (f"Not enough space on {ddisk.mount}: need {human(need)}, "
                                f"{human(max(0, ddisk.free - FREE_MARGIN))} usable.")
    return items, skipped, None


def execute_move(it: MoveItem, leave_link: bool, progress, cancel: threading.Event) -> None:
    dest_dir = os.path.dirname(it.pairs[0][1])
    os.makedirs(dest_dir, exist_ok=True)
    if it.same_fs:
        done = []
        try:
            for src, dst in it.pairs:
                if os.path.lexists(dst):
                    raise FileExistsError(dst)
                os.rename(src, dst)
                done.append((src, dst))
        except BaseException:
            for src, dst in reversed(done):
                try:
                    os.rename(dst, src)
                except OSError:
                    pass
            raise
    else:
        tmps, renamed = [], []
        try:
            for src, dst in it.pairs:
                tmp = os.path.join(dest_dir, f".{os.path.basename(dst)}.model-space-partial")
                if os.path.lexists(tmp):
                    remove_path(tmp)
                tmps.append(tmp)
                if os.path.isdir(src) and not os.path.islink(src):
                    copy_tree(src, tmp, progress, cancel)
                else:
                    copy_file(src, tmp, progress, cancel)
            for (src, _), tmp in zip(it.pairs, tmps):
                if tree_signature(src) != tree_signature(tmp):
                    raise OSError(errno.EIO, f"verification failed for {src}")
            if cancel.is_set():
                raise Cancelled()
            for (_, dst), tmp in zip(it.pairs, tmps):
                if os.path.lexists(dst):
                    raise FileExistsError(dst)
                os.rename(tmp, dst)
                renamed.append(dst)
        except BaseException:
            for p in tmps + renamed:
                try:
                    if os.path.lexists(p):
                        remove_path(p)
                except OSError:
                    pass
            raise
        fsync_dir(dest_dir)
        for src, _ in it.pairs:
            remove_path(src)
    if leave_link:
        for src, dst in it.pairs:
            os.symlink(dst, src)
    for link, old in it.link_targets.items():
        new = map_moved(old, it.pairs)
        if new != old and os.path.islink(link):
            tmp = link + ".model-space-tmp"
            try:
                os.symlink(new, tmp)
                os.replace(tmp, link)
            except OSError:
                pass


def map_moved(p: str, pairs) -> str:
    for s, d in pairs:
        if p == s:
            return d
        if p.startswith(s + "/"):
            return d + p[len(s):]
    return p


def guard_delete(m: Model, protected: set) -> None:
    p = os.path.normpath(m.path)
    if not os.path.isabs(p) or p in protected or p.count("/") < 2:
        raise PermissionError(f"refusing to delete protected path {p}")
    if os.path.islink(p):
        raise PermissionError(f"{p} is now a symlink — rescan first")


def ollama_delete(m: Model) -> None:
    store, manifest = m.extra["store"], m.extra["manifest"]
    if os.access(os.path.dirname(manifest), os.W_OK) and os.access(os.path.join(store, "blobs"), os.W_OK):
        os.unlink(manifest)
        still = {d for ds in ollama_manifests(store).values() for d in ds}
        for b in m.files:
            if os.path.basename(b).replace("-", ":", 1) not in still:
                try:
                    os.unlink(b)
                except FileNotFoundError:
                    pass
        return
    exe = shutil.which("ollama")
    if not exe:
        raise PermissionError(f"{store} isn't writable and the ollama CLI wasn't found")
    r = subprocess.run([exe, "rm", m.extra["name"]], capture_output=True, text=True, timeout=120)
    if r.returncode != 0 or os.path.exists(manifest):
        msg = (r.stderr or r.stdout).strip() or "manifest still present"
        raise RuntimeError(f"ollama rm failed: {msg} (is the Ollama server for this store running?)")


def execute_delete(m: Model, protected: set) -> None:
    if m.source == "ollama":
        ollama_delete(m)
    elif m.is_dir:
        guard_delete(m, protected)
        shutil.rmtree(m.path)
    else:
        guard_delete(m, protected)
        for f in m.files:
            try:
                os.unlink(f)
            except FileNotFoundError:
                pass
    for link in m.links:  # links that now dangle
        if os.path.islink(link) and not os.path.exists(link):
            try:
                os.unlink(link)
            except OSError:
                pass


