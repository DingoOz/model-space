class OpScreen(ModalScreen[None]):
    """Progress for a running move/delete."""

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, title: str, total: int, cancel: threading.Event):
        super().__init__()
        self.title_text, self.total, self.cancel = title, max(1, total), cancel
        self.done_bytes = 0
        self.started = time.monotonic()
        self.finished = False
        self.samples: list[tuple[float, int]] = []

    def compose(self) -> ComposeResult:
        with Vertical(id="op"):
            yield Label(self.title_text, id="op-title")
            yield Static(id="op-current")
            yield ProgressBar(total=self.total, show_eta=False, id="op-bar")
            yield Static(id="op-stats")
            yield RichLog(id="op-log", wrap=True, markup=False)
            with Horizontal(id="op-buttons"):
                yield Button("Cancel", id="op-cancel", variant="warning")

    def set_current(self, text: str) -> None:
        self.query_one("#op-current", Static).update(Text(text, style="bold", no_wrap=True, overflow="ellipsis"))

    def advance(self, n: int) -> None:
        self.done_bytes += n
        self.query_one(ProgressBar).update(progress=self.done_bytes)
        now = time.monotonic()
        self.samples.append((now, self.done_bytes))
        self.samples = [s for s in self.samples if now - s[0] < 5]
        rate = 0.0
        if len(self.samples) > 1 and self.samples[-1][0] > self.samples[0][0]:
            rate = (self.samples[-1][1] - self.samples[0][1]) / (self.samples[-1][0] - self.samples[0][0])
        eta = (self.total - self.done_bytes) / rate if rate > 0 else 0
        p = palette(self.app)
        t = Text()
        t.append(f"{human(self.done_bytes)} / {human(self.total)}", style=f"bold {p.fg}")
        if rate:
            t.append(f"   {human(rate)}/s", style=p.accent)
            t.append(f"   {int(eta // 60)}m {int(eta % 60):02d}s left", style=p.muted)
        self.query_one("#op-stats", Static).update(t)

    def log_line(self, text: str, kind: str = "") -> None:
        p = palette(self.app)
        style = {"ok": p.ok, "err": p.err, "warn": p.warn}.get(kind, p.fg)
        self.query_one(RichLog).write(Text(text, style=style))

    def finish(self, summary: str) -> None:
        self.finished = True
        self.set_current(summary)
        b = self.query_one("#op-cancel", Button)
        b.label, b.variant = "Close", "primary"
        b.focus()

    @on(Button.Pressed, "#op-cancel")
    def action_cancel(self) -> None:
        if self.finished:
            self.dismiss(None)
        elif not self.cancel.is_set():
            self.cancel.set()
            self.log_line("Cancelling — finishing the current chunk and cleaning up…", "warn")


class DirsOnly(DirectoryTree):
    def filter_paths(self, paths):
        out = []
        for p in paths:
            try:
                if p.is_dir() and not p.name.startswith("."):
                    out.append(p)
            except OSError:
                pass
        return out


